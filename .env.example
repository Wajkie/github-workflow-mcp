# Required
GITHUB_TOKEN=ghp_your_token_here
GITHUB_ORG=your-org-name

# Optional — defaults shown
ALLOWED_REPOS=*          # comma-separated list, or * for all repos in the org
ALLOW_WRITES=false       # must be true to enable write tools (Phase 2)
LOG_LEVEL=info           # debug | info | warn | error
# LINT_CWD=/path/to/your/project  # Directory whose eslint.config.js and tsconfig.json are used for linting. Defaults to the server's own directory.
# PORT=3000               # Set to enable HTTP+SSE transport (MCP over HTTP on this port)

# Optional — security (HTTP transport only)
# MCP_SECRET=your-secret-here    # If set, /mcp requires x-mcp-secret header to match
# MAX_BODY_BYTES=1048576          # Max request body size in bytes (default: 1 MB)
# MAX_SESSIONS=100                # Max concurrent HTTP sessions (default: 100)

# Optional — audit logging (omit to disable)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# REDIS_URL=redis://host:6379    # caching
